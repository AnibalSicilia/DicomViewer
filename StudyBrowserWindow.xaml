<Window x:Class="DicomViewer.StudyBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"     
        Title="Studies" Height="600" Width="900"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <!-- Four rows: studies, a title, series, status -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
  
        <!-- ROW 0: the table of studies -->
        <ListView x:Name="StudyList" Grid.Row="0" SelectionMode="Single"
                  SelectionChanged="StudyList_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Patient" Width="180" DisplayMemberBinding="{Binding Patient}" />
                    <GridViewColumn Header="Patient ID" Width="110" DisplayMemberBinding="{Binding PatientId}" />
                    <GridViewColumn Header="Study date" Width="90" DisplayMemberBinding="{Binding Date}" />
                    <GridViewColumn Header="Modalities" Width="90" DisplayMemberBinding="{Binding Modalities}" />
                    <GridViewColumn Header="Description" Width="280" DisplayMemberBinding="{Binding Description}" />
                    <GridViewColumn Header="Series" Width="60" DisplayMemberBinding="{Binding SeriesCount}" />
                </GridView>
            </ListView.View>
        </ListView>

        <!-- ROW 1: title for the series table -->
        <TextBlock Grid.Row="1" Text="Series in the selected study:" FontWeight="Bold" Margin="0,10,0,5"/>
        
        <!-- ROW 2: the table of series -->
        <ListView x:Name="SeriesList" Grid.Row="2" SelectionMode="Single">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="#" Width="60" DisplayMemberBinding="{Binding Number}" />
                    <GridViewColumn Header="Modality" Width="80" DisplayMemberBinding="{Binding Modality}" />
                    <GridViewColumn Header="Description" Width="380" DisplayMemberBinding="{Binding Descriptions}" />
                    <GridViewColumn Header="Images" Width="70" DisplayMemberBinding="{Binding ImageCount}" />
                </GridView>
            </ListView.View>
        </ListView>
        
        <!-- ROW 3: status line -->
        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,10,0,0" Text="Loading studies..."/>
    </Grid>
</Window>
