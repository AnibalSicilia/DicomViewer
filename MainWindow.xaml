<Window x:Class="DicomViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DicomViewer"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        KeyDown="Window_KeyDown">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="OpenButton" Content="Open DICOM file..." Padding="10,5" 
                    Click="OpenButton_Click"/>
            <TextBlock Text="Server:" VerticalAlignment="Center" Margin="20,0,5,0"/>
            <Grid Width="230">
                <ComboBox x:Name="ServerBox" Width="230" VerticalContentAlignment="Center" 
                          SelectionChanged="ServerBox_SelectionChanged"/>
                <TextBlock x:Name="ServerPlaceholder" Text="Select a server..."
                           Foreground="Black" VerticalAlignment="Center" Margin="8,0,0,0"
                           IsHitTestVisible="False"/>
            </Grid>
            <Button x:Name="BrowseButton" Content="Browse studies..." Padding="10,5" 
                    Margin="10,0,0,0" Click="BrowseButton_Click"
                    IsEnabled="False"/>
            <Button x:Name="BackToGridButton" Content="Back to grid" Padding="10,5"
                    Margin="10,0,0,0" Visibility="Collapsed" Click="BackToGridButton_Click" />
        </StackPanel>

        <TextBlock x:Name="InfoText" DockPanel.Dock="Bottom" Margin="0,10,0,0"
                   FontFamily="Consolas" FontSize="14" 
                   Text="No file loaded."/>
        <!--<Border Background="Black">
            <Image x:Name="ScanImage" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </Border>-->
        
        <Grid Background="Black">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ThumbnailColumn" Width="0"/>
                <ColumnDefinition x:Name="SliceColumn" Width="*"/>
            </Grid.ColumnDefinitions>
            

            <!-- LEFT COLUMN: thumbnails (grid when wide, filmstrip when narrow) -->
            <ScrollViewer x:Name="ThumbnailView" Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="Transparent"
                          MouseLeftButtonUp="ThumbnailView_MouseLeftButtonUp">
                <StackPanel>
                    <!-- Header, only visible in grid mode -->
                    <StackPanel x:Name="GridHeader" Margin="10,10,10,5" Visibility="Collapsed">
                        <TextBlock x:Name="HeaderTitle" Foreground="White"
                                   FontSize="20" FontWeight="Bold"/>
                        <TextBlock x:Name="HeaderDetails" Foreground="LightGray"
                                   FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    
                    <WrapPanel x:Name="ThumbnailPanel" Margin="5"/>
                </StackPanel>
            </ScrollViewer>
            
            <!-- RIGHT COLUMN: one large slice with < > on its edges-->
            <Grid x:Name="SliceView" Grid.Column="1" Background="Black"
                  MouseWheel="SliceView_MouseWheel"
                  MouseLeftButtonDown="SliceView_MouseLeftButtonDown">



                <!-- the large image -->
                <Image x:Name="ScanImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                <!-- the < > and counter, drawn on top of the image  -->
                <Grid x:Name="NavigationLayer" Visibility="Collapsed">
                    <Button x:Name="PreviousButton" Content="&lt;" FontSize="20" Width="40" Height="60" Margin="10"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Click="PreviousButton_Click"/>
                    <Button x:Name="NextButton" Content="&gt;" FontSize="20" Width="40" Height="60" Margin="10"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Click="NextButton_Click"/>
                    <TextBlock x:Name="SliceCounter" Text="Slice 0 / 0" Foreground="White" FontSize="14"
                           Margin="0,0,0,10" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
